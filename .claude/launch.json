{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ai-gateway",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "export PATH=\"$HOME/.cargo/bin:$PATH\"; exec cargo run --release"
      ],
      "port": 8099,
      "autoPort": true
    },
    {
      "name": "ai-gateway-worker",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "export PATH=\"$HOME/.nvm/versions/node/v24.14.1/bin:$PATH\"; exec npx wrangler@4.120.0 dev --port \"$PORT\""
      ],
      "port": 8787,
      "autoPort": true
    },
    {
      "name": "noveum-platform",
      "url": "http://localhost:3000",
      "port": 3000
    }
  ]
}
